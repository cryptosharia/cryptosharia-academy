# Public env vars (prefixed with `PUBLIC_`) are exposed to the client.

# Local dev:
PUBLIC_APP_URL=http://localhost:5177
# Production example:
# PUBLIC_APP_URL=https://academy.cryptosharia.id

# CryptoSharia API base URL (public).
# Preview example:
PUBLIC_CS_API_URL=https://preview.api.cryptosharia.id
# Production example:
# PUBLIC_CS_API_URL=https://api.cryptosharia.id

# Private env vars (no `PUBLIC_` prefix) are server-only.

# CryptoSharia API key for server-side requests
CS_API_KEY=

# PostgreSQL database connection
DATABASE_URL=postgresql://user:password@localhost:5432/cryptosharia_academy
